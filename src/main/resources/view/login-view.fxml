<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.CustomTextField?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="raizLogin"
           fx:controller="com.mantenimiento.cmms.controller.LoginController"
           styleClass="app,login"
           prefWidth="1060.0" prefHeight="700.0"
           alignment="CENTER">

    <HBox styleClass="login-diseno" minHeight="700.0" maxHeight="Infinity">

        <!-- Panel de marca con foto industrial -->
        <StackPane styleClass="login-foto" HBox.hgrow="ALWAYS"
                   minWidth="420.0" maxHeight="Infinity">
            <VBox alignment="BOTTOM_LEFT" spacing="14.0" styleClass="login-foto-capota">

                <HBox alignment="CENTER_LEFT" spacing="13.0">
                    <ImageView fitWidth="58.0" fitHeight="58.0"
                               pickOnBounds="true" smooth="true">
                        <image><Image url="@img/logo.png"/></image>
                    </ImageView>
                    <VBox spacing="1.0">
                        <Label text="ManteniMax" styleClass="login-foto-titulo"/>
                        <Label text="Planta industrial · Gestion de mantenimiento"
                               styleClass="login-foto-empresa"/>
                    </VBox>
                </HBox>

                <Label text="Tu planta, bajo control: órdenes, kardex y preventivo en un solo lugar."
                       styleClass="login-foto-lema" wrapText="true"/>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="Kardex en vivo" styleClass="chip-foto">
                        <graphic><FontIcon iconLiteral="fth-package"/></graphic>
                    </Label>
                    <Label text="Prevención automática" styleClass="chip-foto">
                        <graphic><FontIcon iconLiteral="fth-calendar"/></graphic>
                    </Label>
                    <Label text="Reportes Excel y PDF" styleClass="chip-foto">
                        <graphic><FontIcon iconLiteral="fth-bar-chart-2"/></graphic>
                    </Label>
                </HBox>

            </VBox>
        </StackPane>

        <!-- Formulario -->
        <VBox alignment="CENTER" spacing="0.0"
              minWidth="440.0" maxWidth="440.0" styleClass="login-caja">

            <!-- Logo y titulo -->
            <VBox alignment="CENTER" spacing="12.0" styleClass="login-cabecera">
                <ImageView fitWidth="76.0" fitHeight="76.0"
                           pickOnBounds="true" smooth="true">
                    <image><Image url="@img/logo.png"/></image>
                </ImageView>
                <Label text="ManteniMax" styleClass="login-titulo"/>
                <Label text="Sistema de gestion de mantenimiento" styleClass="login-subtitulo"/>
            </VBox>

            <!-- Tarjeta del formulario -->
            <VBox fx:id="tarjeta" spacing="16.0" styleClass="tarjeta,login-tarjeta">
                <Label text="INICIAR SESION" styleClass="seccion-form"/>

                <VBox styleClass="campo">
                    <Label text="Usuario" styleClass="campo-label"/>
                    <CustomTextField fx:id="txtUsuario" promptText="Tu usuario">
                        <left><FontIcon iconLiteral="fth-user"/></left>
                    </CustomTextField>
                    <Label styleClass="campo-error" visible="false" managed="false"/>
                </VBox>

                <VBox styleClass="campo">
                    <Label text="Contrasena" styleClass="campo-label"/>
                    <PasswordField fx:id="txtContrasena" promptText="Tu contrasena"/>
                    <Label styleClass="campo-error" visible="false" managed="false"/>
                </VBox>

                <Label fx:id="lblError" styleClass="login-error" visible="false" managed="false"
                       wrapText="true" maxWidth="Infinity"/>

                <Label fx:id="lblEstado" text="" styleClass="login-estado"
                       visible="false" managed="false" wrapText="true" maxWidth="Infinity"/>

                <Button fx:id="btnIngresar" text="Ingresar al sistema" onAction="#onIngresar"
                        styleClass="accent,boton-principal,login-boton" maxWidth="Infinity" defaultButton="true">
                    <graphic><FontIcon iconLiteral="fth-log-in"/></graphic>
                </Button>
            </VBox>

            <!-- Cuentas de demostracion -->
            <VBox spacing="4.0" styleClass="login-demo">
                <Label text="CUENTAS DE DEMOSTRACION" styleClass="nav-seccion"/>
                <Label text="admin / admin123  ·  Supervisor: jefe / jefe123" styleClass="login-demo-texto"/>
                <Label text="Tecnico: carlos / carlos123" styleClass="login-demo-texto"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="8.0" styleClass="login-pie">
                <Button text="Salir" onAction="#onSalir" styleClass="button-outlined">
                    <graphic><FontIcon iconLiteral="fth-power"/></graphic>
                </Button>
            </HBox>
        </VBox>

    </HBox>
</StackPane>
